# ============================================
# SISMOPAZ - Archivos excluidos de Git
# ============================================

# Dependencias de Node.js (raíz, backend y frontend)
node_modules/
backend/node_modules/
frontend/node_modules/

# Archivos de compilación y empaquetado
backend/dist/
dist/
frontend/.next/
.next/
*.tsbuildinfo

# Variables de entorno y secretos
.env
.env.local
.env.*.local
*.env
backend/.env
frontend/.env
frontend/.env.local

# Permitir archivos .env.example como documentación
!.env.example
!backend/.env.example
!frontend/.env.example

# Logs y depuración
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Reportes generados por scripts de diagnóstico
reporte-validacion.txt

# Archivos temporales y del sistema operativo
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*.bak
