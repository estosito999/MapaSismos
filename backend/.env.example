# Configuración de Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=123456
DB_DATABASE=sismopaz_db

# Configuración JWT (RNF03: HMAC-SHA256, expiración 60m)
